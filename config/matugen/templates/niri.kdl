layout {
    focus-ring {
        active-color "#{{colors.primary.default.hex_stripped}}"
        inactive-color "#{{colors.outline.default.hex_stripped}}"
        urgent-color "#{{colors.error.default.hex_stripped}}"
    }

    border {
        active-color "#{{colors.primary.default.hex_stripped}}"
        inactive-color "#{{colors.outline_variant.default.hex_stripped}}"
        urgent-color "#{{colors.error.default.hex_stripped}}"
    }

    shadow {
        color "#{{colors.shadow.default.hex_stripped}}70"
        inactive-color "#{{colors.shadow.default.hex_stripped}}40"
    }

    tab-indicator {
        active-color "#{{colors.primary.default.hex_stripped}}"
        inactive-color "#{{colors.surface_variant.default.hex_stripped}}"
        urgent-color "#{{colors.error.default.hex_stripped}}"
    }

    insert-hint {
        color "#{{colors.primary.default.hex_stripped}}80"
    }

    background-color "#{{colors.surface.default.hex_stripped}}"
}

overview {
    backdrop-color "#{{colors.surface_container_lowest.default.hex_stripped}}"
}
